    "@fastify/helmet": "^12.0.0",
    "@fastify/rate-limit": "^10.2.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-fastify": "^11.0.0",
    "argon2": "^0.41.0",
    "fastify": "^5.1.0",
    "jose": "^5.9.0",
    "nestjs-pino": "^4.1.0",
    "pino": "^9.4.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@swc/core": "^1.10.0",
    "@types/node": "^22.10.0",
    "dotenv-cli": "^8.0.0",
