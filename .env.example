# Copy to .env.local and fill in. Never commit a filled-in copy.
# Secrets are read from the platform environment in preview and production.

# --- Database -------------------------------------------------------------
# The application connects as daybook_app, which owns nothing and cannot read
# the credential tables. Migrations run as the owner, with a separate URL.
DATABASE_NAME=daybook_dev
DATABASE_URL=postgresql://daybook_app:CHANGE_ME@localhost:5432/daybook_dev?schema=public
DATABASE_AUTH_URL=postgresql://daybook_auth:CHANGE_ME@localhost:5432/daybook_dev?schema=public
# Migrations, introspection and the schema assertions run as the owner, never
# as the application role: daybook_app cannot create a table, grant a privilege
# or insert a user, and all three of those are the point of a migration.
DATABASE_MIGRATION_URL=postgresql://daybook:CHANGE_ME@localhost:5432/daybook_dev?schema=public

# The integration tests create and destroy real users, so they get their own
# database. Pointing these at the development database would work right up
# until a test's cleanup step deleted something that mattered.
TEST_DATABASE_URL=postgresql://daybook_app:CHANGE_ME@localhost:5432/daybook_test?schema=public
TEST_DATABASE_AUTH_URL=postgresql://daybook_auth:CHANGE_ME@localhost:5432/daybook_test?schema=public
TEST_DATABASE_MIGRATION_URL=postgresql://daybook:CHANGE_ME@localhost:5432/daybook_test?schema=public

# Ceilings on a transaction, not waits. Prisma's defaults of 5000 and 2000
# assume the database is next to the process; in development it is a laptop
# talking to another country, and every statement in a transaction is a round
# trip. Raising these turns a slow network into a slow request rather than
# a 500.
DATABASE_TRANSACTION_TIMEOUT_MS=20000
DATABASE_TRANSACTION_MAX_WAIT_MS=10000

# --- API ------------------------------------------------------------------
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
# Where verification and password-reset links point. The Daybook app, not the
# API: the API has no pages.
APP_PUBLIC_URL=http://localhost:3000
NODE_ENV=development
LOG_LEVEL=debug
# Comma-separated origins permitted to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# --- Auth -----------------------------------------------------------------
# Ed25519 keypair for signing access tokens, PEM, base64-encoded to survive
# single-line environment variables. Generate with:
#   openssl genpkey -algorithm ed25519 -out private.pem
#   openssl pkey -in private.pem -pubout -out public.pem
#   base64 -w0 private.pem
AUTH_JWT_PRIVATE_KEY_B64=
AUTH_JWT_PUBLIC_KEY_B64=
# Names the signing key inside each token, so a key can be rotated without
# invalidating every token issued under the previous one.
AUTH_JWT_KEY_ID=daybook-ed25519-1
AUTH_ACCESS_TOKEN_TTL_SECONDS=600
AUTH_REFRESH_TOKEN_TTL_DAYS=30
AUTH_EMAIL_TOKEN_TTL_HOURS=24
AUTH_RESET_TOKEN_TTL_MINUTES=60
AUTH_COOKIE_NAME=db_rt
# Empty in development, since both apps share localhost.
AUTH_COOKIE_DOMAIN=
AUTH_ARGON2_MEMORY_KIB=65536
AUTH_ARGON2_TIME_COST=3
AUTH_ARGON2_PARALLELISM=1
# Requests per minute per IP on the sign-in, registration and reset endpoints.
AUTH_RATE_LIMIT_PER_MINUTE=10

# Google sign-in. Optional: leave both blank and the routes answer 503 rather
# than pretending the feature does not exist. Set both or neither; a client id
# without a secret fails at boot rather than at somebody's first sign-in.
#
# The redirect URI points at the API, not at a frontend, because the API is the
# OAuth client: the client secret cannot live in a browser. It must match the
# value registered in the Google Cloud console exactly, including the scheme.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:4000/v1/auth/google/callback

# --- Frontends ------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000/v1
DAYBOOK_PORT=3000
FITNESS_PORT=3001

# --- Worker ---------------------------------------------------------------
WORKER_CONCURRENCY=4
MATERIALISER_HORIZON_DAYS=90

# --- Notifications, Phase 11 ---------------------------------------------
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
