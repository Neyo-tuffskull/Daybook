{
  "name": "daybook",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "playwright test",
    "db:migrate": "pnpm --filter @daybook/db db:migrate",
    "db:migrate:test": "pnpm --filter @daybook/db db:migrate:test",
    "db:smoke": "pnpm --filter @daybook/db db:smoke",
    "test:integration": "pnpm --filter @daybook/api test:integration",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@next/eslint-plugin-next": "^15.5.0",
    "@playwright/test": "^1.47.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.11.0",
    "prettier": "^3.3.0",
    "turbo": "^2.1.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.46.0"
  }
}
