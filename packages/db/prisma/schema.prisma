generator client {
  provider        = "prisma-client-js"
  output          = "../generated/client"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [citext, pgcrypto]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model activities {
  id                                                               String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                                                          String                   @db.Uuid
  series_id                                                        String?                  @db.Uuid
  occurrence_date                                                  DateTime                 @db.Date
  title                                                            String
  description                                                      String?
  category_id                                                      String?                  @db.Uuid
  priority                                                         Int                      @default(2) @db.SmallInt
  planned_start                                                    DateTime                 @db.Timestamptz(6)
  planned_end                                                      DateTime                 @db.Timestamptz(6)
  planned_duration_minutes                                         Int?                     @default(dbgenerated("((EXTRACT(epoch FROM (planned_end - planned_start)) / (60)::numeric))::integer"))
  status                                                           String                   @default("planned")
  completion_ratio                                                 Decimal?                 @db.Decimal(3, 2)
  actual_start                                                     DateTime?                @db.Timestamptz(6)
  actual_end                                                       DateTime?                @db.Timestamptz(6)
  actual_duration_minutes                                          Int?
  start_deviation_minutes                                          Int?                     @default(dbgenerated("((EXTRACT(epoch FROM (actual_start - planned_start)) / (60)::numeric))::integer"))
  notes                                                            String?
  source                                                           String                   @default("manual")
  is_detached                                                      Boolean                  @default(false)
  manually_overridden                                              Boolean                  @default(false)
  sync_issue                                                       Boolean                  @default(false)
  workout_session_id                                               String?                  @db.Uuid
  origin_event_id                                                  String?                  @db.Uuid
  last_synced_event_at                                             DateTime?                @db.Timestamptz(6)
  reminder_sent_at                                                 DateTime?                @db.Timestamptz(6)
  created_at                                                       DateTime                 @default(now()) @db.Timestamptz(6)
  updated_at                                                       DateTime                 @default(now()) @db.Timestamptz(6)
  deleted_at                                                       DateTime?                @db.Timestamptz(6)
  activity_categories                                              activity_categories?     @relation(fields: [category_id], references: [id], onUpdate: NoAction)
  domain_events                                                    domain_events?           @relation(fields: [origin_event_id], references: [id], onUpdate: NoAction, map: "activities_origin_event_fkey")
  activity_series                                                  activity_series?         @relation(fields: [series_id], references: [id], onUpdate: NoAction)
  users                                                            users                    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  workout_sessions_activities_workout_session_idToworkout_sessions workout_sessions?        @relation("activities_workout_session_idToworkout_sessions", fields: [workout_session_id], references: [id], onUpdate: NoAction, map: "activities_workout_session_fkey")
  activity_status_events                                           activity_status_events[]
  workout_sessions_workout_sessions_activity_idToactivities        workout_sessions[]       @relation("workout_sessions_activity_idToactivities")

  @@index([category_id], map: "activities_category_idx")
  @@index([series_id], map: "activities_series_idx")
  @@index([user_id, status, occurrence_date], map: "activities_user_status_date_idx")
  @@index([workout_session_id], map: "activities_workout_session_idx")
}

